{
  "name": "hermes-learning-lab",
  "private": true,
  "version": "1.1.0",
  "description": "13 节中文交互实验，从安装 Hermes 到安全运行多 Agent 工作流。",
  "license": "MIT",
  "keywords": [
    "hermes-agent",
    "ai-agents",
    "chinese-tutorial",
    "interactive-learning",
    "multi-agent",
    "feishu"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare:companion && vite build",
    "build:pages": "npm run prepare:companion && vite build --mode pages",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "prepare:companion": "node scripts/package-companion.mjs",
    "local:bridge": "node companion/cli.mjs",
    "lint": "eslint src tests companion scripts playwright.config.js vite.config.js --max-warnings=0",
    "test:content": "node --test tests/content/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test:content && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "vite": "8.1.5"
  }
}
